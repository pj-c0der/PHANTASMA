# Gmail account used to send booking notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-studio-email@gmail.com
SMTP_PASSWORD=your-google-app-password

# Inbox that receives booking notifications.
BOOKING_NOTIFICATION_EMAIL=your-studio-email@gmail.com

# Automatic delivery retries for temporary SMTP/network failures.
EMAIL_SEND_ATTEMPTS=3
EMAIL_RETRY_DELAY_SECONDS=2
